{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/catalogo", "destination": "/paginas/catalogo.html", "permanent": true },
    { "source": "/carrito", "destination": "/paginas/carrito.html", "permanent": true },
    { "source": "/login", "destination": "/paginas/login.html", "permanent": true },
    { "source": "/admin", "destination": "/paginas/admin.html", "permanent": true },
    { "source": "/registro", "destination": "/crearUsuario.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
